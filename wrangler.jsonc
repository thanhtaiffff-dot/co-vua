// Cài đặt cho Cloudflare. Web gồm hai phần:
// - các file tĩnh Vite build ra trong dist (trang web, code chạy trên máy người chơi, hình, tiếng);
// - worker/index.ts: máy chủ nhỏ lo chơi online, chỉ chạy cho các địa chỉ /api/...
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chess",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Mỗi phòng chơi online là một Durable Object lớp ChessRoom (xem worker/room-server.ts); hàng chờ góp ý là một
  // Durable Object lớp FeedbackBox duy nhất (worker/feedback-box.ts).
  // Gói miễn phí của Cloudflare chỉ cho loại lưu bằng SQLite, nên khai báo ở "new_sqlite_classes". Mỗi lần thêm lớp mới
  // là thêm một dòng "migrations" mới, không sửa dòng cũ.
  // Góp ý thành Issue trong repo riêng tư này. Token GitHub để tạo Issue là Secret tên GITHUB_TOKEN, dán trong trang
  // quản lý Cloudflare (Worker chess > Settings > Variables and Secrets), không nằm ở đây.
  "vars": { "GITHUB_REPO": "thanhtaiffff-dot/co-vua-gop-y" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ChessRoom" },
      { "name": "FEEDBACK", "class_name": "FeedbackBox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChessRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["FeedbackBox"] }
  ]
}
